{
  "manifest_version": 3,
  "name": "Andrew Inbox",
  "version": "1.0",
  "action": {
    "default_popup": "ui-react/dist/index.html",
    "default_icon": "AndrewInboxLogo128.png"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.supabase.co/*", "http://127.0.0.1:8000/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src 'self' https://*.supabase.co http://127.0.0.1:8000"
  }
}
