{
  "manifest_version": 3,
  "name": "Andrew Inbox",
  "version": "1.0",
  "action": {
    "default_popup": "ui-react/dist/index.html"
  },
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.supabase.co/*"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self';"
  }
}
